# Megu-bot / Node A: copy this file to bots/demo/.env.
# Credentials stay local. Do not commit .env, openids, keys, logs or databases.
# Always select this file explicitly with QQBOT_ENV_FILE; see README.md.
# Relative paths below assume the repository root is the working directory.
# The demo launcher changes to that root before reusing scripts/launch.js.
# For another bot, change every demo path and use its own credentials and lock.

# QQ Open Platform credentials: fill in locally before connecting to QQ.
# https://q.qq.com/
QQ_APP_ID=
QQ_CLIENT_SECRET=
# This flag changes the log label only; configure sandbox access on the platform.
QQBOT_SANDBOX=false
QQ_API_BASE=https://api.bot.qq.com
# GROUP_AND_C2C_EVENT: group mentions and direct messages.
QQBOT_INTENTS=33554432
QQBOT_SELF_GROUP_IDS=

# Optional flat JSON runtime parameters (docs/41). Unset means no new file IO.
# Lower priority than this dotenv file and the process environment; no secrets/paths.
# QQBOT_PARAMS_FILE=data/demo/params.json

# Local directories; create your own AGENTS.md as described in README.md.
QQBOT_HOME=data/demo/home
QQBOT_WORKSPACE=data/demo/workspace
QQBOT_STATE_DB=data/demo/state.db
QQBOT_LOCK_FILE=data/demo/bot.lock
QQBOT_LOG_FILE=data/demo/bridge.log
# An explicit empty value disables importing an old JSON state file.
QQBOT_LEGACY_STATE_FILE=

# OpenAI-compatible model endpoint. These two example values are not credentials.
# Empty endpoint/model values use the same built-in defaults.
QQBOT_LLM_BASEURL=https://api.deepseek.com/v1
QQBOT_LLM_MODEL=deepseek-chat
QQBOT_LLM_KEY=
# Optional fallback slots; not required for the public demo. Keep keys empty.
# QQBOT_LLM_DREAM_BASEURL=
# QQBOT_LLM_DREAM_MODEL=
# QQBOT_LLM_DREAM_KEY=
# Empty = do not set these request options; provider support must be checked.
QQBOT_LLM_REASONING_EFFORT=
QQBOT_LLM_MAX_TOKENS=

# Access: allowlist + an empty list replies to nobody (fail closed).
# IDs are platform openids, NOT QQ numbers. Never paste real IDs into this template.
# Group member_openid and direct-message user_openid are different scopes.
QQBOT_ACCESS_MODE=allowlist
QQBOT_IDS=
QQBOT_ADMIN_IDS=

# Reply limits and pacing (milliseconds unless stated otherwise).
QQBOT_REPLY_TIMEOUT_MS=240000
QQBOT_MAX_CHARS=1500
QQBOT_MAX_CONCURRENCY=2
QQBOT_PROMPT_CONTEXT=true
QQBOT_MAX_IMAGES=3
QQBOT_C2C_DEBOUNCE_MS=3000
QQBOT_REPLY_JITTER_MS=2000-6000
QQBOT_STRIP_NAME_LABELS=
QQBOT_KAOMOJI_BREAK_WIDTH=32
QQBOT_LOG_LEVEL=info

# Mention-only group mode: no automatic conversation participation.
QQBOT_GROUP_MODE=mention
QQBOT_GROUP_CONTEXT=15
QQBOT_GROUP_CONTEXT_MINUTES=10
QQBOT_GROUP_DEBOUNCE_MS=6000
QQBOT_GROUP_COOLDOWN_MS=120000
QQBOT_RECHECK_MINUTES=10
QQBOT_GROUP_ENGAGED_COOLDOWN_MS=15000
QQBOT_GROUP_MIN_MESSAGES=2
QQBOT_GROUP_WINDOW_MS=90000
QQBOT_GROUP_ADDRESS_MARKERS=你,妳,您,汝
# Explicit neutral keyword list, not an empty value that can select defaults.
# Keywords do not enable automatic participation in mention mode.
QQBOT_GROUP_KEYWORDS=示例助手

# Optional world pack selection (docs/42). A world pack supplies world-level
# shared text; unset means no world pack is selected (legacy local content or
# neutral defaults). The public set ships only a neutral example world.
# QQBOT_WORLD=example

# Optional stylistic/state systems are off in this minimal demo.
# demo is the neutral theme identifier; body and mood themes must match.
QQBOT_MOOD=false
QQBOT_MOOD_THEME=demo
QQBOT_BODY_THEME=demo
QQBOT_MOOD_TTL_MS=600000
QQBOT_MOOD_KAOMOJI_CHANCE=0.3
QQBOT_MOOD_HARD_TRUNCATE=true
QQBOT_STYLE_NUDGES=0
# Optional chat-style pack (expression/organisation only). Values come from
# content/styles/<id>/style.json; default legacy-online = the previous spoken
# defaults. Only expression data is selectable here: account keys, paths,
# budgets, tools and feature authorization can never come from a style pack.
# Unknown ids fail closed at startup. This is an instance setting, not a
# character/world/style data field.
QQBOT_STYLE_PACK=legacy-online
QQBOT_SERIOUS_GUARD=true
QQBOT_POKE=false
QQBOT_POKE_REPLY_CHANCE=0.35
QQBOT_FACE=false
QQBOT_FACE_REPLY_CHANCE=0.15
QQBOT_INTERACTION_WINDOW_MULTIPLIER=2
QQBOT_INTERACTION_COOLDOWN_MS=180000
QQBOT_STATS=false
# Defense in depth if local users later opt in to stats: no currency flavor.
QQBOT_STATS_MONEY=false
QQBOT_REPORT_TARGET_NAME=示例助手
QQBOT_REPORT_TARGET_THEME=demo
QQBOT_ECONOMY=false
QQBOT_ECONOMY_TASKS=false
QQBOT_ECONOMY_EVENTS=false
QQBOT_GROWTH=false
QQBOT_GROWTH_ANNOUNCE=off
QQBOT_GROWTH_C2C=
QQBOT_GROWTH_CONCEPTS=false

# Scheduled and unsolicited messages: all disabled.
QQBOT_WARMUP=false
QQBOT_WARMUP_MODE=random
QQBOT_WARMUP_SLOT_MS=7200000
QQBOT_WARMUP_CHANCE=0.5
QQBOT_WARMUP_MIN_CHANCE=0.1
QQBOT_WARMUP_ENGAGE_WINDOW_MS=600000
QQBOT_WARMUP_GAP_MS=1800000
QQBOT_WARMUP_INTERVAL_MS=3600000
QQBOT_WARMUP_SLEEP=23:00-08:00
QQBOT_WARMUP_QUIET_MS=300000
QQBOT_WARMUP_TICK_MS=30000
QQBOT_WARMUP_MEAL_HOURS=6-10,11-14,17-20
QQBOT_SELFCARE=false
QQBOT_SELFCARE_QUIET_MS=2400000
QQBOT_SELFCARE_HUNGRY=25
QQBOT_SELFCARE_GAP_MS=2700000
QQBOT_SELFCARE_LIFE_EVERY_MS=10800000
QQBOT_SELFCARE_LIFE_CHANCE=0.5
QQBOT_SELFCARE_C2C=
QQBOT_SELFCARE_LIFE_TO=group
QQBOT_SELFCARE_GROUP=
QQBOT_MORNING=
QQBOT_MORNING_C2C=
QQBOT_MORNING_GRACE_MS=3600000
QQBOT_ANNOUNCE=false
QQBOT_ANNOUNCE_MODE=character
QQBOT_ANNOUNCE_TARGETS=c2c
QQBOT_ANNOUNCE_C2C=
QQBOT_ANNOUNCE_TRIGGER=manual

# Optional memory; disabled here, including background model summarization.
# Paths remain explicit so later opt-in stays within this demo's data directory.
QQBOT_MEMORY=false
QQBOT_MEMORY_DB=data/demo/memory.db
QQBOT_MEMORY_BUDGET=1400
QQBOT_MEMORY_RECENT=10
QQBOT_MEMORY_LONGTERM=false
QQBOT_MEMORY_LONGTERM_BUDGET=300
QQBOT_MEMORY_LONGTERM_LIMIT=3
QQBOT_MEMORY_ARCHIVE_MINUTES=15
QQBOT_MEMORY_CONSOLIDATE_MINUTES=360
QQBOT_MEMORY_NOTE_TTL_DAYS=3
QQBOT_MEMORY_CONSOLIDATE_WINDOW_DAYS=3
QQBOT_MEMORY_SUMMARY=false
QQBOT_MEMORY_SUMMARY_CHARS=400
QQBOT_MEMORY_SUMMARY_BUDGET=480
QQBOT_MEMORY_SUMMARY_TIMEOUT_SECONDS=45
QQBOT_MEMORY_SUMMARY_MIN_INTERVAL_MINUTES=180
QQBOT_MEMORY_SUMMARY_SESSION_CALLS=20
QQBOT_MEMORY_BLOCKS=false
QQBOT_MEMORY_INSIGHTS=false
QQBOT_MEMORY_EMBEDDING=false
QQBOT_MEMORY_KB=false

# Compatibility configuration retained, but optional content is not supplied.
# Keep disabled in this public demo. No drawing runtime is required for bot+images.
QQBOT_EXPLOSION=false
QQBOT_EXPLOSION_COOLDOWN_SECONDS=90
QQBOT_EXPLOSION_DELAY_MS=1000
QQBOT_EXPLOSION_BEATS_MAX=4
QQBOT_NARRATION=false
QQBOT_NARRATION_COOLDOWN_SECONDS=20
QQBOT_NARRATION_TIMEOUT_SECONDS=45
QQBOT_PYTHON=

# Image-fetching pipeline: opt in locally only after checking source/platform rules.
# Empty group allowlist denies all groups, independently of QQBOT_IDS.
# Matched aliases use deterministic code; an unresolved name may call the model
# once for interpretation. Retrieval/download/sending stay in code.
# No real alias table is supplied.
QQBOT_MEITU=false
QQBOT_MEITU_GROUPS=
QQBOT_MEITU_MAX=5
QQBOT_MEITU_COOLDOWN_MS=30000
QQBOT_MEITU_PROXY=
QQBOT_MEITU_ROOT=data/demo/images
QQBOT_MEITU_ALIAS=data/demo/meitu-alias.json
QQBOT_MEITU_LINES=data/demo/meitu-lines.json
QQBOT_MEITU_SOURCE=auto
QQBOT_MEITU_MAX_BYTES=10485760
QQBOT_MEITU_TIMEOUT_MS=90000

# Advanced web configuration is retained for compatibility, NOT supported by the
# Node A public set. Do not enable these switches; no web UI is distributed here.
QQBOT_PANEL=false
QQBOT_PANEL_HOST=127.0.0.1
QQBOT_PANEL_PORT=8799
QQBOT_PANEL_TOKEN=
QQBOT_PANEL_CODE=
QQBOT_PANEL_PUBLIC_URL=
QQBOT_PANEL_ALLOWED_HOSTS=
QQBOT_ACCOUNTS=false
QQBOT_ACCOUNTS_OPEN=false
QQBOT_GALLERY=false

# Model tools are disabled. No tool/search credentials are needed for this demo.
QQBOT_TOOLS=false
QQBOT_TOOLS_MODEL_FN=false
QQBOT_TOOLS_ALLOW=
QQBOT_SEARCH_BASEURL=
QQBOT_SEARCH_KEY=
